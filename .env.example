# Copy to .env. scripts/install_prerequisites.sh does this when .env is missing.
#
# ollama = local dev (default)
# vllm   = RunPod / production
# One command can override the file: make index LLM_BACKEND=vllm
LLM_BACKEND=ollama

# Any non-empty value. Ollama and vLLM do not check this key.
GRAPHRAG_API_KEY=ollama
